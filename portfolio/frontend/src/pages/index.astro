---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { Button, buttonVariants } from "@/components/ui/button";
import { CardWrapper } from "@/components/CardWrapper";
import { CarouselWrapper } from "@/components/CarouselWrapper";
import { Mail } from "lucide-react";
import { RiBlueskyLine } from "react-icons/ri";
import { GithubIcon } from "@/components/ui/github";
import { LinkedinIcon } from "@/components/ui/linkedin";
import { DiscordIcon } from "@/components/ui/discord";

const projects = await getCollection('projects');
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>Alex's Portfolio</title>
    </head>

    <body class="bg-black text-white min-h-screen relative overflow-x-hidden">
        
        <!-- Background via Three.js (fixed inset-0 -z-10 puts it behind) -->
        <canvas id="canvas" class="fixed inset-0 -z-10 w-full h-full pointer-events-none"></canvas>

        <!-- Content (z-10 sits on top) -->
        <div class="relative z-10 grid place-items-center h-screen content-center p-4">

            <!-- Main Content Container -->
            <div id="main-content" class="flex flex-col items-center text-center gap-6">
                <h1 class="font-mono text-4xl md:text-6xl font-bold">Alex Alvarez</h1>
                <h2 class="font-mono text-xl md:text-2xl">senior software engineer @ RTX</h2>
                
                <div class="flex gap-4 mt-4">
                    <Button id="about-btn" size="lg" variant="default" className="w-32">About</Button>
                    <Button id="projects-btn" size="lg" variant="default" className="w-32">Projects</Button>
                </div>

                <div class="flex gap-2 mt-2">
                    <a href="https://github.com/alvy023" target="_blank" rel="noreferrer">
                        <Button variant="ghost" size="icon">
                            <GithubIcon client:load className="[&_svg]:!size-6" />
                        </Button>
                    </a>
                    <a href="#" target="_blank" rel="noreferrer">
                        <Button variant="ghost" size="icon">
                            <DiscordIcon client:load className="[&_svg]:!size-6" />
                        </Button>
                    </a>
                    <a href="#">
                        <Button variant="ghost" size="icon">
                            <RiBlueskyLine className="size-6" />
                        </Button>
                    </a>
                    <a href="https://linkedin.com/in/aralvarez023" target="_blank" rel="noreferrer">
                        <Button variant="ghost" size="icon">
                            <LinkedinIcon client:load className="[&_svg]:!size-6" />
                        </Button>
                    </a>
                    <a href="mailto:mail@alex-alvarez.com">
                        <Button variant="ghost" size="icon">
                            <Mail className="size-6" />
                        </Button>
                    </a>
                </div>
            </div>

            <div id="about-container" class="hidden flex items-center gap-4 w-3xl transition-all duration-300 ease-in-out">
                <CardWrapper />
            </div>
            
            <div id="projects-container" class="hidden flex items-center gap-4 w-3xl transition-all duration-300 ease-in-out">
                <CarouselWrapper client:load projects={projects} />
            </div>

			<!-- <a href="/" class={buttonVariants({ variant: "default" })}>API Link</a> -->

        </div>

        <script src="../scripts/background.js"></script>
        <script src="../scripts/about.ts"></script>
        <script src="../scripts/projects.ts"></script>
    </body>
</html>
