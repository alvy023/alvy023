---
import '../../styles/global.css';
import { getCollection, render } from 'astro:content';
import { Button } from '@/components/ui/button';
import { GithubIcon } from '@/components/ui/github';
import { ArrowLeft, ExternalLink, Workflow } from 'lucide-react';

export async function getStaticPaths() {
    const projects = await getCollection('projects');
    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, coverImage, tags, links } = project.data;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title} — Alex's Portfolio</title>
    </head>

    <body class="bg-black text-white min-h-screen">
        <div class="max-w-3xl mx-auto px-4 py-12">
            <a href="/" class="inline-flex items-center gap-2 text-sm opacity-80 hover:opacity-100 mb-8">
                <ArrowLeft className="size-4" />
                Back
            </a>

            <img src={coverImage} alt={title} class="w-full rounded-lg mb-6 border border-white/10" />

            <h1 class="font-mono text-3xl md:text-4xl font-bold mb-2">{title}</h1>
            <p class="text-lg opacity-90 mb-4">{summary}</p>

            {tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-6">
                    {tags.map((tag) => (
                        <span class="text-xs px-2 py-1 rounded-full border border-white/20 opacity-80">{tag}</span>
                    ))}
                </div>
            )}

            {(links.repo || links.site || links.workflow) && (
                <div class="flex gap-3 mb-10">
                    {links.repo && (
                        <a href={links.repo} target="_blank" rel="noreferrer">
                            <Button variant="secondary" size="sm" className="gap-2">
                                <GithubIcon client:load className="[&_svg]:!size-4" />
                                Repo
                            </Button>
                        </a>
                    )}
                    {links.site && (
                        <a href={links.site} target="_blank" rel="noreferrer">
                            <Button variant="secondary" size="sm" className="gap-2">
                                <ExternalLink className="size-4" />
                                Site
                            </Button>
                        </a>
                    )}
                    {links.workflow && (
                        <a href={links.workflow} target="_blank" rel="noreferrer">
                            <Button variant="secondary" size="sm" className="gap-2">
                                <Workflow className="size-4" />
                                Workflow
                            </Button>
                        </a>
                    )}
                </div>
            )}

            <div class="[&_h2]:font-mono [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:mt-10 [&_h2]:mb-3
                        [&_h3]:font-mono [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:mt-6 [&_h3]:mb-2
                        [&_p]:mb-4 [&_p]:leading-relaxed [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-4
                        [&_a]:underline [&_a]:underline-offset-2 [&_a]:opacity-90 [&_a:hover]:opacity-100">
                <Content />
            </div>
        </div>
    </body>
</html>
